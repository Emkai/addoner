pkgname=addoner
pkgver=0.1.0
pkgrel=1
pkgdesc='Browse CurseForge and install World of Warcraft addons'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'libarchive')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/addoner "$pkgdir/usr/bin/addoner"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/addoner.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/addoner.svg"
  install -Dm644 "$startdir/addoner.desktop" "$pkgdir/usr/share/applications/addoner.desktop"
}
